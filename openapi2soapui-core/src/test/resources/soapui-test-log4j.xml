<?xml version="1.0" encoding="UTF-8"?>
<Configuration>
    <Appenders>
        <Console name="STDERR" target="SYSTEM_ERR">
            <PatternLayout pattern="%-5p [%c{1}] %m%n"/>
        </Console>
    </Appenders>
    <Loggers>
        <logger name="com.eviware.soapui" level="WARN" additivity="false">
            <AppenderRef ref="STDERR"/>
        </logger>
        <logger name="groovy.log" level="WARN" additivity="false">
            <AppenderRef ref="STDERR"/>
        </logger>
        <logger name="soapui.errorlog" level="WARN" additivity="false">
            <AppenderRef ref="STDERR"/>
        </logger>
        <Root level="WARN">
            <AppenderRef ref="STDERR"/>
        </Root>
    </Loggers>
</Configuration>
